{
  "title": "Change a session's mode",
  "description": "Section 8. ACP session/set_mode switches the session to the agent's full-access mode; the next command runs without asking. Other attached clients receive current_mode_update.",
  "steps": [
    {"note": "Open a connection to the host (through its relay, or on the LAN).", "connect": "host"},
    {"note": "The first frame is host/hello: the versions this client speaks and the device credential from pairing.", "send": {"jsonrpc": "2.0", "id": 1, "method": "host/hello", "params": {"protocol": {"min": "0.1", "max": "0.1"}, "client": {"name": "oal-conformance", "version": "0.1.0"}, "auth": {"type": "device", "deviceId": "{{deviceId}}", "token": "{{token}}"}}}},
    {"note": "The host picks 0.1 and says which device this connection is. `info` is the same object host/info returns.", "expect": {"jsonrpc": "2.0", "id": 1, "result": {"protocol": "0.1", "device": {"id": "{{deviceId}}"}, "info": {"host": {"id": "{{hostId}}"}}}}},
    {"note": "ACP starts every agent channel with initialize. The host answers it itself with the agent's capabilities; the client's are not passed on.", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": false, "writeTextFile": false}, "terminal": false}, "clientInfo": {"name": "oal-conformance", "version": "0.1.0"}}}}},
    {"note": "ACP protocol version 1. No sign-in methods: the agent runs under its owner's own sign-in on the host.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true}, "authMethods": []}}}},
    {"note": "ACP session/new, unchanged. cwd is the agent's folder from host/agents; a remote client can't pick another folder or add MCP servers that run commands.", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"cwd": "{{folder}}", "mcpServers": []}}}},
    {"note": "The agent's own session id and modes. This connection is now attached to the session.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "{{session}}", "modes": {"currentModeId": "ask", "availableModes": [{"id": "ask"}, {"id": "folder"}, {"id": "full"}]}}}}},
    {"note": "ACP session/set_mode, unchanged. `full` is this agent's mode for running anything without asking; a host may refuse that remotely.", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 3, "method": "session/set_mode", "params": {"sessionId": "{{session}}", "modeId": "full"}}}},
    {"note": "Done.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 3, "result": {}}}},
    {"note": "ACP session/prompt, unchanged.", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 4, "method": "session/prompt", "params": {"sessionId": "{{session}}", "prompt": [{"type": "text", "text": "run: echo hi"}]}}}},
    {"note": "The turn starts.", "expect": {"jsonrpc": "2.0", "method": "host/turn", "params": {"agent": "{{agent}}", "sessionId": "{{session}}", "turnId": "{{turn}}", "state": "running"}}},
    {"note": "The tool call...", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "tool_call", "toolCallId": "{{call}}", "title": "echo hi", "kind": "execute", "status": "pending"}}}}},
    {"note": "...runs with no permission request.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "tool_call_update", "toolCallId": "{{call}}", "status": "completed", "content": [{"type": "content", "content": {"type": "text", "text": "hi"}}]}}}}},
    {"note": "The reply.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Done."}}}}}},
    {"note": "The prompt's answer.", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 4, "result": {"stopReason": "end_turn"}}}},
    {"note": "The turn ends.", "expect": {"jsonrpc": "2.0", "method": "host/turn", "params": {"agent": "{{agent}}", "sessionId": "{{session}}", "turnId": "{{turn}}", "state": "ended", "stopReason": "end_turn", "usage": {"inputTokens": 12, "outputTokens": 5, "totalTokens": 17}}}}
  ]
}
