{
  "title": "Reconnect in the middle of a turn",
  "description": "Section 12. The phone drops while the agent waits for permission. It reconnects, loads the session, and gets the conversation so far, the running turn, and the same permission request.",
  "steps": [
    {"note": "Open a connection to the host (through its relay, or on the LAN).", "conn": "first", "connect": "host"},
    {"note": "The first frame is host/hello: the versions this client speaks and the device credential from pairing.", "conn": "first", "send": {"jsonrpc": "2.0", "id": 1, "method": "host/hello", "params": {"protocol": {"min": "0.1", "max": "0.1"}, "client": {"name": "oal-conformance", "version": "0.1.0"}, "auth": {"type": "device", "deviceId": "{{deviceId}}", "token": "{{token}}"}}}},
    {"note": "The host picks 0.1 and says which device this connection is. `info` is the same object host/info returns.", "conn": "first", "expect": {"jsonrpc": "2.0", "id": 1, "result": {"protocol": "0.1", "device": {"id": "{{deviceId}}"}, "info": {"host": {"id": "{{hostId}}"}}}}},
    {"note": "ACP starts every agent channel with initialize. The host answers it itself with the agent's capabilities; the client's are not passed on.", "conn": "first", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": false, "writeTextFile": false}, "terminal": false}, "clientInfo": {"name": "oal-conformance", "version": "0.1.0"}}}}},
    {"note": "ACP protocol version 1. No sign-in methods: the agent runs under its owner's own sign-in on the host.", "conn": "first", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true}, "authMethods": []}}}},
    {"note": "ACP session/new, unchanged. cwd is the agent's folder from host/agents; a remote client can't pick another folder or add MCP servers that run commands.", "conn": "first", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"cwd": "{{folder}}", "mcpServers": []}}}},
    {"note": "The agent's own session id and modes. This connection is now attached to the session.", "conn": "first", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "{{session}}", "modes": {"currentModeId": "ask", "availableModes": [{"id": "ask"}, {"id": "folder"}, {"id": "full"}]}}}}},
    {"note": "ACP session/prompt, unchanged.", "conn": "first", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"sessionId": "{{session}}", "prompt": [{"type": "text", "text": "run: echo hi"}]}}}},
    {"note": "The turn starts.", "conn": "first", "expect": {"jsonrpc": "2.0", "method": "host/turn", "params": {"agent": "{{agent}}", "sessionId": "{{session}}", "turnId": "{{turn}}", "state": "running"}}},
    {"note": "The tool call.", "conn": "first", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "tool_call", "toolCallId": "{{call}}", "title": "echo hi", "kind": "execute", "status": "pending"}}}}},
    {"note": "The permission request arrives...", "conn": "first", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": "{{permReq}}", "method": "session/request_permission", "params": {"sessionId": "{{session}}", "toolCall": {"toolCallId": "{{call}}", "title": "echo hi"}, "options": [{"optionId": "allow-once", "kind": "allow_once"}, {"optionId": "reject-once", "kind": "reject_once"}]}}}},
    {"note": "...and the connection drops before anyone answers. The host keeps the turn and the request.", "conn": "first", "close": true},
    {"note": "Open a connection to the host (through its relay, or on the LAN).", "conn": "second", "connect": "host"},
    {"note": "The first frame is host/hello: the versions this client speaks and the device credential from pairing.", "conn": "second", "send": {"jsonrpc": "2.0", "id": 1, "method": "host/hello", "params": {"protocol": {"min": "0.1", "max": "0.1"}, "client": {"name": "oal-conformance", "version": "0.1.0"}, "auth": {"type": "device", "deviceId": "{{deviceId}}", "token": "{{token}}"}}}},
    {"note": "The host picks 0.1 and says which device this connection is. `info` is the same object host/info returns.", "conn": "second", "expect": {"jsonrpc": "2.0", "id": 1, "result": {"protocol": "0.1", "device": {"id": "{{deviceId}}"}, "info": {"host": {"id": "{{hostId}}"}}}}},
    {"note": "ACP starts every agent channel with initialize. The host answers it itself with the agent's capabilities; the client's are not passed on.", "conn": "second", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": false, "writeTextFile": false}, "terminal": false}, "clientInfo": {"name": "oal-conformance", "version": "0.1.0"}}}}},
    {"note": "ACP protocol version 1. No sign-in methods: the agent runs under its owner's own sign-in on the host.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true}, "authMethods": []}}}},
    {"note": "Load the session again: ACP session/load, unchanged.", "conn": "second", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "method": "session/load", "params": {"sessionId": "{{session}}", "cwd": "{{folder}}", "mcpServers": []}}}},
    {"note": "The host replays the session's record: first the prompt...", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "user_message_chunk", "content": {"type": "text", "text": "run: echo hi"}}}}}},
    {"note": "...then the tool call so far.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "tool_call", "toolCallId": "{{call}}", "status": "pending"}}}}},
    {"note": "The turn is still running.", "conn": "second", "expect": {"jsonrpc": "2.0", "method": "host/turn", "params": {"agent": "{{agent}}", "sessionId": "{{session}}", "turnId": "{{turn}}", "state": "running"}}},
    {"note": "The load answer carries the session's current modes.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": 2, "result": {"modes": {"currentModeId": "ask"}}}}},
    {"note": "The pending permission request, sent again as a new request on this connection.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": "{{permReq2}}", "method": "session/request_permission", "params": {"sessionId": "{{session}}", "toolCall": {"toolCallId": "{{call}}", "title": "echo hi"}, "options": [{"optionId": "allow-once", "kind": "allow_once"}, {"optionId": "reject-once", "kind": "reject_once"}]}}}},
    {"note": "Approve it.", "conn": "second", "send": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "id": "{{permReq2}}", "result": {"outcome": {"outcome": "selected", "optionId": "allow-once"}}}}},
    {"note": "The result.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "tool_call_update", "toolCallId": "{{call}}", "status": "completed", "content": [{"type": "content", "content": {"type": "text", "text": "hi"}}]}}}}},
    {"note": "The reply.", "conn": "second", "expect": {"agent": "{{agent}}", "acp": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "{{session}}", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Done."}}}}}},
    {"note": "The turn ends. The PromptResponse was for the closed connection; host/turn carries the same outcome here.", "conn": "second", "expect": {"jsonrpc": "2.0", "method": "host/turn", "params": {"agent": "{{agent}}", "sessionId": "{{session}}", "turnId": "{{turn}}", "state": "ended", "stopReason": "end_turn", "usage": {"inputTokens": 12, "outputTokens": 5, "totalTokens": 17}}}}
  ]
}
