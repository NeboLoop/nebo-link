{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagent.link/schemas/0.1/host-agents.schema.json",
  "title": "host/agents",
  "description": "Lists the host's agents. Request, client to host.",
  "$defs": {
    "params": {
      "type": "object"
    },
    "result": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/Agent"
          }
        }
      },
      "required": [
        "agents"
      ]
    }
  }
}
